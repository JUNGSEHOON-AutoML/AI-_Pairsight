diff --git a/tests/unit/environmentOnlyGateway.test.ts b/tests/unit/environmentOnlyGateway.test.ts
new file mode 100644
index 0000000..df8157b
--- /dev/null
+++ b/tests/unit/environmentOnlyGateway.test.ts
@@ -0,0 +1,30 @@
+// @vitest-environment node
+import { afterEach, expect, it, vi } from 'vitest';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+const dirs: string[] = [];
+afterEach(() => { vi.unstubAllEnvs(); vi.resetModules(); for (const dir of dirs.splice(0)) fs.rmSync(dir, { recursive: true, force: true }); });
+it('keeps the gateway fixed to env and never persists its token', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'studio-env-only-')); dirs.push(dir);
+  vi.stubEnv('OPENCLAW_STATE_DIR', dir);
+  vi.stubEnv('CLAW3D_GATEWAY_ENV_ONLY', '1');
+  vi.stubEnv('CLAW3D_GATEWAY_URL', 'ws://127.0.0.1:3451');
+  vi.stubEnv('CLAW3D_GATEWAY_TOKEN', 'new-test-credential-not-a-real-secret');
+  vi.stubEnv('CLAW3D_GATEWAY_ADAPTER_TYPE', 'demo');
+  const { loadStudioSettings, saveStudioSettings, applyStudioSettingsPatch } = await import('../../src/lib/studio/settings-store');
+  const settings = loadStudioSettings();
+  saveStudioSettings(settings);
+  const raw = fs.readFileSync(path.join(dir, 'claw3d/settings.json'), 'utf8');
+  expect(raw).not.toContain(process.env.CLAW3D_GATEWAY_TOKEN);
+  expect(loadStudioSettings().gateway?.token).toBe(process.env.CLAW3D_GATEWAY_TOKEN);
+  applyStudioSettingsPatch({ gateway: { url: 'ws://untrusted.example:1', token: 'ignored', adapterType: 'demo' } });
+  expect(loadStudioSettings().gateway?.url).toBe('ws://127.0.0.1:3451');
+  const server = require('../../server/studio-settings.js');
+  expect(server.loadUpstreamGatewaySettings(process.env)).toMatchObject({ url: 'ws://127.0.0.1:3451', token: process.env.CLAW3D_GATEWAY_TOKEN, adapterType: 'demo' });
+  vi.stubEnv('CLAW3D_GATEWAY_TOKEN', '');
+  expect(() => loadStudioSettings()).toThrow(/requires URL and token/);
+  expect(() => server.loadUpstreamGatewaySettings(process.env)).toThrow(/requires URL and token/);
+});
diff --git a/tests/unit/officeEventArrivalTime.test.ts b/tests/unit/officeEventArrivalTime.test.ts
new file mode 100644
index 0000000..c5b20cc
--- /dev/null
+++ b/tests/unit/officeEventArrivalTime.test.ts
@@ -0,0 +1,18 @@
+import { afterEach, expect, it, vi } from 'vitest';
+import type { AgentState } from '@/features/agents/state/store';
+import { buildOfficeAnimationState, createOfficeAnimationEventUpdate, createOfficeAnimationTriggerState } from '@/lib/office/eventTriggers';
+afterEach(() => vi.useRealTimers());
+it('a React updater retry cannot renew working or streaming latches for an old event', () => {
+  vi.useFakeTimers();
+  vi.setSystemTime(100_000);
+  const agents = [{ agentId: 'judge', sessionKey: 'agent:judge:main', status: 'idle', runId: null, outputLines: [], transcriptEntries: [] }] as unknown as AgentState[];
+  const update = createOfficeAnimationEventUpdate({ agents, event: { type: 'event', event: 'chat', payload: { sessionKey: 'agent:judge:main', runId: 'run-1', state: 'final', message: { role: 'assistant', content: 'completed' } } } });
+  const previous = createOfficeAnimationTriggerState();
+  const first = update(previous);
+  vi.setSystemTime(200_000);
+  const retried = update(previous);
+  expect(retried).toEqual(first);
+  const projection = buildOfficeAnimationState({ state: retried, agents, nowMs: Date.now() });
+  expect(projection.streamingByAgentId).toEqual({});
+  expect(Object.values(projection.workingUntilByAgentId).every(until => until < Date.now())).toBe(true);
+});
diff --git a/tests/unit/productionWasmCsp.test.ts b/tests/unit/productionWasmCsp.test.ts
new file mode 100644
index 0000000..2f5ed4b
--- /dev/null
+++ b/tests/unit/productionWasmCsp.test.ts
@@ -0,0 +1,11 @@
+// @vitest-environment node
+import { afterEach, expect, it, vi } from 'vitest';
+afterEach(() => { vi.unstubAllEnvs(); vi.resetModules(); });
+it('permits the Three.js WebAssembly text renderer without enabling JavaScript eval', async () => {
+  vi.stubEnv('NODE_ENV', 'production');
+  const { default: config } = await import('../../next.config');
+  const routes = await config.headers!();
+  const csp = routes[0].headers.find(h => h.key === 'Content-Security-Policy')!.value;
+  expect(csp).toContain("'wasm-unsafe-eval'");
+  expect(csp).not.toContain("'unsafe-eval'");
+});
